{
  "name": "opencode-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n opencode,next \"pnpm opencode\" \"next dev\"",
    "opencode": "opencode serve --port 4096",
    "build": "next build",
    "start": "concurrently -n opencode,next \"pnpm opencode\" \"next start\"",
    "lint": "oxlint",
    "mcp": "pnpm --filter opencode-mcp start",
    "mcp:test": "pnpm --filter opencode-mcp test"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.32",
    "next": "^16.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
