  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
